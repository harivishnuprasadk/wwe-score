rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Players share one login; the owner keeps a separate admin login for restoring backups.
    function isGroup() {
      return request.auth != null && request.auth.token.email == 'group@tagledger.app';
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@tagledger.app';
    }
    function isMember() {
      return isGroup() || isAdmin();
    }

    function validMatch(m) {
      return m.keys().hasOnly(['date', 't', 'team1', 'team2', 'wrestlers1', 'wrestlers2', 'winner', 'counted', 'createdAt', 'flag', 'voided', 'late'])
        && m.date is string && m.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && m.t is number
        && m.team1 is list && m.team1.size() == 2
        && m.team2 is list && m.team2.size() == 2
        && m.winner in [1, 2] && m.counted is bool
        && m.createdAt is timestamp
        && validWrestlers(m, 'wrestlers1') && validWrestlers(m, 'wrestlers2')
        && (!('late' in m) || m.late is bool);
    }

    // A flag on a disputed result: a short reason, stamped with the server clock.
    function validFlag(f) {
      return f is map && f.keys().hasOnly(['reason', 'at'])
        && f.reason is string && f.reason.size() > 0 && f.reason.size() <= 140
        && f.at == request.time;
    }

    // Optional: the wrestler each player used ("" when not picked). Older matches don't have it.
    function validWrestlers(m, key) {
      return !(key in m) || (m[key] is list && m[key].size() == 2);
    }

    // Is the match date today (with a day of slack either side for time zones)?
    function isToday(dateStr) {
      let p = dateStr.split('-');
      let d = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      return d > request.time - duration.value(2, 'd') && d < request.time + duration.value(1, 'd');
    }

    // Not in the future (same slack as isToday).
    function notFuture(dateStr) {
      let p = dateStr.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) < request.time + duration.value(1, 'd');
    }

    // Player and team names: 1-30 characters, no "/".
    function isName(n) {
      return n is string && n.matches('^[^/]{1,30}$');
    }

    // Players are added by name. The document id is the lowercased name, so "Hari" and "hari" can't both exist.
    match /players/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['name', 'alias', 'hidden', 'createdAt'])
        && isName(request.resource.data.name)
        && id == request.resource.data.name.lower()
        && validPlayerExtras(request.resource.data)
        && request.resource.data.createdAt == request.time;
      // Editing a player: only the alias and whether they're deleted (hidden). The name never changes,
      // because past matches are locked with it.
      allow update: if isMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['alias', 'hidden'])
        && validPlayerExtras(request.resource.data);
      // Removing the record entirely is left to the admin; the app hides players instead.
      allow delete: if isAdmin();
    }

    // Optional alias (up to 30 characters) and hidden flag ("deleted" in the app).
    function validPlayerExtras(p) {
      return (!('alias' in p) || isNick(p.alias)) && (!('hidden' in p) || p.hidden is bool);
    }

    // A team is two players, stored in lowercase order, with an optional nickname.
    // The id is "<player1>+<player2>" in lowercase, so the same pair can't be added twice.
    function isNick(n) {
      return n is string && n.size() <= 30;
    }
    match /teams/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['players', 'nick', 'createdAt'])
        && request.resource.data.players is list && request.resource.data.players.size() == 2
        && isName(request.resource.data.players[0]) && isName(request.resource.data.players[1])
        && request.resource.data.players[0].lower() < request.resource.data.players[1].lower()
        && id == request.resource.data.players[0].lower() + '+' + request.resource.data.players[1].lower()
        && isNick(request.resource.data.nick)
        && request.resource.data.createdAt == request.time;
      // Only the admin can rename a team (change or clear its nickname); nothing else about a team changes.
      // Anyone can still give a nickname when first adding a team.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick'])
        && isNick(request.resource.data.nick);
      allow delete: if isAdmin();
    }

    match /matches/{id} {
      allow read: if isMember();

      // New match: stamped with Google's server clock, so the 1-hour delete window starts when it's logged.
      // Anyone may log a past date (never a future one), but it must be marked `late: true`,
      // which the app shows as "Added later".
      // Restore (admin only): may carry an older date and time, but only into ids that don't exist yet.
      allow create: if validMatch(request.resource.data)
        && !('flag' in request.resource.data) && !('voided' in request.resource.data) && (
        (isMember() && request.resource.data.createdAt == request.time
          && notFuture(request.resource.data.date)
          && (isToday(request.resource.data.date) || request.resource.data.get('late', false) == true))
        || (isAdmin() && request.resource.data.createdAt < request.time)
      );

      // Scores are never edited. The only changes allowed:
      // - anyone signed in can flag a result they think is wrong (once; it can't be overwritten);
      // - the admin can resolve a flag: void the match (it stops counting) and/or remove the flag.
      allow update: if (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag'])
          && !('flag' in resource.data) && resource.data.get('voided', false) == false
          && validFlag(request.resource.data.flag))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['flag', 'voided'])
          && request.resource.data.get('voided', false) is bool
          && (!('flag' in request.resource.data) || request.resource.data.flag == resource.data.get('flag', null)));

      // A match can be deleted only within 1 hour of being logged. After that it is frozen for everyone.
      allow delete: if isMember() && request.time < resource.data.createdAt + duration.value(1, 'h');
    }
  }
}
